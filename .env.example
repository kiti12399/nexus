# Telegram
BOT_TOKEN=123456:replace_me
BOT_USERNAME=your_bot_username
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/keyshop.db

# Generate with: python -m keyshop_bot.crypto
KEY_ENCRYPTION_KEY=replace_with_fernet_key

# Payments
PAYMENT_PROVIDER=manual_crypto

# Manual crypto payments
CRYPTO_ASSET=USDT
CRYPTO_NETWORK=TRC20
CRYPTO_WALLET_ADDRESS=replace_with_wallet_address
CRYPTO_RUB_PER_UNIT=
CRYPTO_PAYMENT_NOTE=Укажите ID заказа в комментарии к переводу, если сеть поддерживает комментарии.

# YooKassa, for later: set PAYMENT_PROVIDER=yookassa and fill these
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# Web server for YooKassa callbacks
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
PUBLIC_BASE_URL=https://example.com
SITE_CORS_ORIGIN=*

# Email verification
# Fill SMTP_* to send registration codes by email.
# Keep EMAIL_VERIFICATION_DEV_CODES=true for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nexus AI
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_VERIFICATION_DEV_CODES=true

# Business settings
PAYMENT_TIMEOUT_MINUTES=30
SUPPORT_USERNAME=your_support_username
